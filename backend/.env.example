NODE_ENV=development
PORT=4000
# Must match docker-compose.yml defaults (user: notes, password: notes_local_dev).
# notes_dev is created by docker/postgres/init on first container start.
DATABASE_URL=postgresql://notes:notes_local_dev@127.0.0.1:5432/notes_dev
# Used by tests and by `npm run migrate:test`; notes_test is created by the same init script.
TEST_DATABASE_URL=postgresql://notes:notes_local_dev@127.0.0.1:5432/notes_test
JWT_ACCESS_SECRET=change_me_change_me_change_me_change_me
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
